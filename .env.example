CCEVALS_ENVIRONMENT=development
CCEVALS_DATABASE_URL=postgresql+psycopg://ccevals:ccevals@db:5432/ccevals
CCEVALS_REGION=demo-region-1
# Required in production. Derives tenant-scoped identifier tokens.
CCEVALS_TOKENIZATION_SECRET=change-me
# Semantic judge: "none" reports semantic criteria as not evaluated; "anthropic" uses the Messages API.
CCEVALS_JUDGE_PROVIDER=none
CCEVALS_JUDGE_MODEL=claude-opus-5-5
CCEVALS_JUDGE_API_KEY=
CCEVALS_INLINE_EVALUATION=false
CCEVALS_RATE_LIMIT_PER_MINUTE=600
CCEVALS_DECISION_VALIDITY_DAYS=7
